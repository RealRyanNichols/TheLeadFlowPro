[Unit]
Description=The LeadFlow Pro Picture Studio worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Set these to the observed site@leadflow user and group before installation.
User=leadflowsite
Group=leadflowsite
WorkingDirectory=/var/lib/leadflow-releases/current
EnvironmentFile=/srv/site-env/picture-studio.env
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs scripts/picture-studio-worker.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
MemoryMax=512M
CPUQuota=100%
Nice=10
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leadflow-picture-studio
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
