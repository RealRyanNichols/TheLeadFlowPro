# This is a template. Store real values only in protected droplet environment files.
# Keep disabled until the migration, signed Stripe webhook and worker preflight pass.
PICTURE_STUDIO_ENABLED=false
PICTURE_AUTOMATION_ENABLED=false
PICTURE_DATABASE_URL=postgresql://picture_user:REPLACE_SECURELY@127.0.0.1:5432/leadflow
PICTURE_STORAGE_DIR=/var/lib/leadflow-picture-studio
OPENAI_API_KEY=
PICTURE_ADMIN_TOKEN=
STRIPE_SECRET_KEY=
PICTURE_STRIPE_WEBHOOK_SECRET=
# Ceilings may be lowered, never raised by this implementation.
PICTURE_DAILY_BUDGET_CENTS=2500
PICTURE_MAX_IMAGE_COST_CENTS=100
