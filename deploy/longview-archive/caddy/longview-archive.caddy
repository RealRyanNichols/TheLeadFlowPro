# Longview Business Archive staging host (The LeadFlow Pro).
#
# Owner: The LeadFlow Pro, hello@theleadflowpro.com.
# Serves two things from /var/lib/longview-archive/www, both built by the
# engine on this droplet (nothing is deployed anywhere else):
#   - the public Longview business directory at /longview/businesses/ (the
#     approved batch only; / redirects there), the same path it will have on
#     theleadflowpro.com, and each other town that is turned on at
#     /<town>/businesses/, with the towns hub at /places/ (the town list is the
#     one seeded in longview_archive/places.py; a town that is not on has no
#     files, so its paths answer 404);
#   - the private status page at /status, /status/*, and /status.json.
# /robots.txt is answered here. Everything else is a 404. The pages load
# nothing from any other host.
#
# Every response, errors included, says noindex while this is a staging host.
# This file cannot see the engine's LVA_INDEXABLE switch, so the header stays
# on even when the pages drop their noindex tag. Going public means a separate,
# approved change to this file (drop X-Robots-Tag and the robots.txt block for
# the directory paths) together with DNS for the real domain.
#
# Needs Caddy 2.7 or newer (the robots.txt heredoc); preflight.sh checks it.
# Installed by deploy/longview-archive/install.sh. To remove it, run
# /opt/longview-archive/uninstall.sh, or delete this one file and run
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload caddy

# The snippet names are prefixed so they cannot collide with other site files.
# The Content-Security-Policy is set separately (below) because the directory
# allows its one local script and search.json; everything else allows neither.
(longview_archive_headers) {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
		-Server
	}
}

# Everything but the directory: no script, no fetch. The argument is a matcher.
(longview_archive_csp_strict) {
	header {args[0]} Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
}

# The directory: also its one local script (search.js) and its own search.json.
(longview_archive_csp_directory) {
	header {args[0]} Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
}

longview.165-227-248-110.sslip.io {
	root * /var/lib/longview-archive/www
	import longview_archive_headers

	@longview_directory path_regexp (?i)^/(?:(?:longview|marshall|kilgore|white-oak|hallsville|diana|harleton|gladewater|clarksville-city|easton|scottsville|elysian-fields|waskom|ore-city|gilmer|karnack|jefferson|tatum|henderson|carthage|tyler|big-sandy|hawkins|winona|arp|overton|new-london|beckville|pittsburg|daingerfield|lone-star|hughes-springs|linden|mount-pleasant|nacogdoches|palestine|jacksonville|athens|mineola|quitman|winnsboro|mount-vernon|atlanta|queen-city|naples|omaha|avinger|lindale|whitehouse|bullard|troup|rusk|mount-enterprise|center|timpson|tenaha|chandler|brownsboro|van|edgewood|grand-saline|canton|wills-point|frankston|alba|yantis|leesburg|laneville|cushing|garrison|chireno|joaquin)/businesses|places)(?:/.*)?$
	@longview_not_directory not path_regexp (?i)^/(?:(?:longview|marshall|kilgore|white-oak|hallsville|diana|harleton|gladewater|clarksville-city|easton|scottsville|elysian-fields|waskom|ore-city|gilmer|karnack|jefferson|tatum|henderson|carthage|tyler|big-sandy|hawkins|winona|arp|overton|new-london|beckville|pittsburg|daingerfield|lone-star|hughes-springs|linden|mount-pleasant|nacogdoches|palestine|jacksonville|athens|mineola|quitman|winnsboro|mount-vernon|atlanta|queen-city|naples|omaha|avinger|lindale|whitehouse|bullard|troup|rusk|mount-enterprise|center|timpson|tenaha|chandler|brownsboro|van|edgewood|grand-saline|canton|wills-point|frankston|alba|yantis|leesburg|laneville|cushing|garrison|chireno|joaquin)/businesses|places)(?:/.*)?$
	import longview_archive_csp_strict @longview_not_directory
	import longview_archive_csp_directory @longview_directory

	# Answered by Caddy itself, so crawlers are turned away from this staging
	# host even before the engine writes its first file.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# The "*" matters: without it Caddy reads the target as a path matcher.
	handle / {
		redir * /longview/businesses/ 302
	}

	# /<town>/businesses and /places without the slash, in any case: the section's
	# own path with it. The target is the town the pattern captured from the
	# cleaned path, lower-cased by the map, never the request's raw path: a raw
	# //longview/businesses must not become the protocol-relative (another host)
	# //longview/businesses/.
	@longview_directory_bare path_regexp lva_bare (?i)^/(longview|marshall|kilgore|white-oak|hallsville|diana|harleton|gladewater|clarksville-city|easton|scottsville|elysian-fields|waskom|ore-city|gilmer|karnack|jefferson|tatum|henderson|carthage|tyler|big-sandy|hawkins|winona|arp|overton|new-london|beckville|pittsburg|daingerfield|lone-star|hughes-springs|linden|mount-pleasant|nacogdoches|palestine|jacksonville|athens|mineola|quitman|winnsboro|mount-vernon|atlanta|queen-city|naples|omaha|avinger|lindale|whitehouse|bullard|troup|rusk|mount-enterprise|center|timpson|tenaha|chandler|brownsboro|van|edgewood|grand-saline|canton|wills-point|frankston|alba|yantis|leesburg|laneville|cushing|garrison|chireno|joaquin)/businesses$
	handle @longview_directory_bare {
		map {re.lva_bare.1} {lva_town} {
			~(?i)^longview$ longview
			~(?i)^marshall$ marshall
			~(?i)^kilgore$ kilgore
			~(?i)^white-oak$ white-oak
			~(?i)^hallsville$ hallsville
			~(?i)^diana$ diana
			~(?i)^harleton$ harleton
			~(?i)^gladewater$ gladewater
			~(?i)^clarksville-city$ clarksville-city
			~(?i)^easton$ easton
			~(?i)^scottsville$ scottsville
			~(?i)^elysian-fields$ elysian-fields
			~(?i)^waskom$ waskom
			~(?i)^ore-city$ ore-city
			~(?i)^gilmer$ gilmer
			~(?i)^karnack$ karnack
			~(?i)^jefferson$ jefferson
			~(?i)^tatum$ tatum
			~(?i)^henderson$ henderson
			~(?i)^carthage$ carthage
			~(?i)^tyler$ tyler
			~(?i)^big-sandy$ big-sandy
			~(?i)^hawkins$ hawkins
			~(?i)^winona$ winona
			~(?i)^arp$ arp
			~(?i)^overton$ overton
			~(?i)^new-london$ new-london
			~(?i)^beckville$ beckville
			~(?i)^pittsburg$ pittsburg
			~(?i)^daingerfield$ daingerfield
			~(?i)^lone-star$ lone-star
			~(?i)^hughes-springs$ hughes-springs
			~(?i)^linden$ linden
			~(?i)^mount-pleasant$ mount-pleasant
			~(?i)^nacogdoches$ nacogdoches
			~(?i)^palestine$ palestine
			~(?i)^jacksonville$ jacksonville
			~(?i)^athens$ athens
			~(?i)^mineola$ mineola
			~(?i)^quitman$ quitman
			~(?i)^winnsboro$ winnsboro
			~(?i)^mount-vernon$ mount-vernon
			~(?i)^atlanta$ atlanta
			~(?i)^queen-city$ queen-city
			~(?i)^naples$ naples
			~(?i)^omaha$ omaha
			~(?i)^avinger$ avinger
			~(?i)^lindale$ lindale
			~(?i)^whitehouse$ whitehouse
			~(?i)^bullard$ bullard
			~(?i)^troup$ troup
			~(?i)^rusk$ rusk
			~(?i)^mount-enterprise$ mount-enterprise
			~(?i)^center$ center
			~(?i)^timpson$ timpson
			~(?i)^tenaha$ tenaha
			~(?i)^chandler$ chandler
			~(?i)^brownsboro$ brownsboro
			~(?i)^van$ van
			~(?i)^edgewood$ edgewood
			~(?i)^grand-saline$ grand-saline
			~(?i)^canton$ canton
			~(?i)^wills-point$ wills-point
			~(?i)^frankston$ frankston
			~(?i)^alba$ alba
			~(?i)^yantis$ yantis
			~(?i)^leesburg$ leesburg
			~(?i)^laneville$ laneville
			~(?i)^cushing$ cushing
			~(?i)^garrison$ garrison
			~(?i)^chireno$ chireno
			~(?i)^joaquin$ joaquin
			default longview
		}
		redir * /{lva_town}/businesses/ 308
	}
	@longview_directory_hub_bare path_regexp (?i)^/places$
	handle @longview_directory_hub_bare {
		redir * /places/ 308
	}

	# The static directory. A profile, category, or list is a folder with an
	# index.html; "businesses" (and "places") is a link the engine switches in one rename.
	@longview_directory_files path_regexp (?i)^/(?:(?:longview|marshall|kilgore|white-oak|hallsville|diana|harleton|gladewater|clarksville-city|easton|scottsville|elysian-fields|waskom|ore-city|gilmer|karnack|jefferson|tatum|henderson|carthage|tyler|big-sandy|hawkins|winona|arp|overton|new-london|beckville|pittsburg|daingerfield|lone-star|hughes-springs|linden|mount-pleasant|nacogdoches|palestine|jacksonville|athens|mineola|quitman|winnsboro|mount-vernon|atlanta|queen-city|naples|omaha|avinger|lindale|whitehouse|bullard|troup|rusk|mount-enterprise|center|timpson|tenaha|chandler|brownsboro|van|edgewood|grand-saline|canton|wills-point|frankston|alba|yantis|leesburg|laneville|cushing|garrison|chireno|joaquin)/businesses|places)/.*$
	handle @longview_directory_files {
		try_files {path} {path}/index.html
		file_server
	}

	@status path /status /status/ /status/* /status.json
	handle @status {
		file_server
	}

	handle {
		respond "Not found" 404
	}

	# A missing file is an error inside file_server; answer it with the same
	# headers (and the strict policy) instead of Caddy's bare default.
	handle_errors {
		import longview_archive_headers
		import longview_archive_csp_strict *
		respond "{err.status_code}" {err.status_code}
	}
}
