# /etc/theleadflowpro/web.env on the droplet (chmod 600, owned by root).
# NAMES ONLY in this file: the repository is public. Never commit a value.
#
# Fastest way to fill it: on the Mac, in the project folder,
#   vercel env pull --environment=production web.env
# then copy that file to the droplet as /etc/theleadflowpro/web.env and delete
# the local copy. Or paste each value from the Vercel project's Environment
# Variables page. Format: KEY=value, one per line, no spaces around "=".
# Wrap a value in single quotes if it contains a $ sign.
#
# The build reads this file too (as a BuildKit secret), so the NEXT_PUBLIC_
# values are baked into the browser bundle at build time, as on Vercel.

# --- Required: the site does not run without these -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Lead intake and texting ------------------------------------------------
LEADFLOW_NOTIFY_EMAIL=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_LEAD_FORM_IDS=
META_OAUTH_REDIRECT_URI=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_TEST_LEAD_IDS=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_ID=
NEXT_PUBLIC_META_PIXEL_ID=
QUO_API_KEY=
QUO_FROM_NUMBER=
QUO_USER_ID=
QUO_LEADFLOW_USER_ID=
QUO_LEADFLOW_INBOUND_PHONE_NUMBER_ID=
QUO_WEBHOOK_SECRET=
QUO_INBOUND_AUTOREPLY_ENABLED=
QUO_OUTBOUND_SMS_DISABLED=
# Speed to lead (lib/speedToLeadAlertsServer.ts): nothing sends unless exactly
# "true". Staff mobiles are a comma list, 10-digit or E.164. Texts also need
# QUO_OUTBOUND_SMS_DISABLED=false. The per-minute sweep is in vercel.json, so
# cron-runner.mjs picks it up with the rest.
SPEED_TO_LEAD_ENABLED=
SPEED_TO_LEAD_STAFF_PHONES=

# --- Products and payments --------------------------------------------------
STRIPE_WEBSITE_LAUNCH_PAYMENT_LINK_ID=
PRO_TOOLS_SECRET=
SELLERPROOF_SECRET=
CHASE_SHEET_SECRET=
DIAGNOSTIC_RESUME_SECRET=

# --- AI and content -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_OPERATOR_MODEL=
OPENAI_API_KEY=
OPENAI_OPERATOR_MODEL=
OPERATOROS_EXECUTION_ENABLED=
HEYGEN_API_KEY=
CONTENT_COMMAND_WORKER_TOKEN=

# --- Google (Search Console sync and PageSpeed) -----------------------------
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=
GOOGLE_PAGESPEED_API_KEY=

# --- Optional -----------------------------------------------------------------
BASE_URL=
