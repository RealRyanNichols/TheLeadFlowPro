# Installed by deploy/droplet/db.sh setup (proposed; docs/infrastructure/database.md).
[Unit]
Description=The LeadFlow Pro: back up the site's database (db.sh backup)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# A hung run is stopped, so it cannot block the next night's backup.
TimeoutStartSec=30min
ExecStart=/opt/theleadflowpro/deploy/droplet/db.sh backup
Nice=10
IOSchedulingClass=idle
