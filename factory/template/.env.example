# Environment for a factory-built client site. Set these in the CLIENT's own
# Vercel project (Settings > Environment Variables), never in this repo, a
# doc, or a chat. Names only here; every value is blank or a placeholder.
#
# app/api/lead/route.ts reads them. Which ones matter depends on
# site.config.json > leadRoute.kind.

# leadRoute.kind = "email": the client's own Resend key and a verified sender
# on the client's domain. Leads are emailed to leadRoute.to.
RESEND_API_KEY=""
LEAD_FROM_ADDRESS="Leads <leads@example.com>"

# leadRoute.kind = "webhook": optional bearer token the client's CRM expects
# on the POST to leadRoute.url. Leave blank if the CRM does not require one.
LEAD_WEBHOOK_SECRET=""
