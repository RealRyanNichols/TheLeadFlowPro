# Client site environment. Set these three in the client's own Vercel project.
# Names only. Never commit a real value to this repo or paste one in a chat.

# API key from the client's Resend account, with their sending domain verified there.
RESEND_API_KEY=""

# The From address on lead emails. Must be on the domain verified in that Resend account.
LEAD_FROM_ADDRESS="Leads <leads@client-domain.example.com>"

# Only for a webhook lead route. Sent as the bearer token on the POST to the client's CRM or plugin.
LEAD_WEBHOOK_SECRET=""
