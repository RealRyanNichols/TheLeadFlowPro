# Environment variables for The LeadFlow Pro.
#
# EVERY VARIABLE IN THIS FILE IS READ SOMEWHERE IN THE CODE. That was not true
# before: this file used to document Prisma, NextAuth, Twilio, LeadRep and four
# social OAuth providers that nothing reads, while omitting CRON_SECRET,
# UNSUBSCRIBE_SECRET, the QUO_* set, META_VERIFY_TOKEN and the rest of the ones
# that actually matter. A setup file that lists variables which do nothing and
# hides the ones that do is worse than no setup file, because somebody works
# through it, sets everything in it, and still has a broken deployment with no
# idea which piece is missing.
#
# Keep it that way. If you add a process.env read, add it here. If you delete
# the last read of one, delete it here.
#
# Nothing here is secret: every value is blank or public. Real values live in
# Vercel → Settings → Environment Variables.
#
# PUBLIC ENV RULE: only NEXT_PUBLIC_ for browser-safe values (site URL,
# publishable keys, public analytics IDs, the Supabase anon URL and key). Never
# a service role key, a webhook secret, a private token, or lead data.


# =============================================================================
# REQUIRED. Without these the site does not work.
# =============================================================================

# --- Supabase ---
# Both have working defaults baked into lib/config.ts, so local dev runs
# without them. Set them anyway when pointing at a different project.
NEXT_PUBLIC_SUPABASE_URL="https://hpzpwfymwfgwspaixrxi.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# The most-used variable in the codebase. Every cron, every webhook, and every
# admin route needs it. Server-side only, and it bypasses Row Level Security:
# never let this reach the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (every email the app sends) ---
# Without it: no lead alerts, no welcome replies, no nurture, no purchase
# confirmations. The paid Stripe handlers deliberately fail and let Stripe
# retry rather than marking a payment handled with nobody told.
# Sending domain must be verified in Resend or every send is rejected.
RESEND_API_KEY=""

# --- Vercel Cron ---
# Shared secret the cron routes in vercel.json check as `Bearer $CRON_SECRET`.
# Without it those routes are open to anyone who knows the path.
CRON_SECRET=""

# --- Unsubscribe links ---
# Signs the one-click unsubscribe token on every nurture email. The nurture
# cron refuses to send at all without a working unsubscribe.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, so setting this is what
# keeps existing links valid through a Supabase key rotation. It signs only;
# it is never used as a database key.
UNSUBSCRIBE_SECRET=""


# =============================================================================
# PAYMENTS
# =============================================================================

# --- Stripe ---
STRIPE_SECRET_KEY=""
# Stripe Dashboard → Webhooks → the endpoint → Signing secret (whsec_...).
# The endpoint path is /api/stripe-webhook. See COWORK_PUNCHLIST.md Task 2 for
# the events to subscribe to.
STRIPE_WEBHOOK_SECRET=""
# Public resource ID of the Website Launch Payment Link. The webhook uses it to
# recognize the $500 deposit when a direct Payment Link carries no metadata.
# lib/stripeCheckout.ts holds the current default; set this only to override.
STRIPE_WEBSITE_LAUNCH_PAYMENT_LINK_ID=""


# =============================================================================
# SMS (Quo). READ THIS BEFORE SETTING ANYTHING HERE.
# =============================================================================
#
# APPLICATION-ORIGINATED OUTBOUND SMS IS OFF AND STAYS OFF. The only text this
# app may ever send is the auto-reply to somebody who texted us first, handled
# in /api/quo-inbound. Nothing else is routed through it.
#
# Both switches below are deliberately backwards, so that an unset variable is
# the safe state and turning texting on takes a deliberate act:
#   QUO_OUTBOUND_SMS_DISABLED  is treated as "true" unless it is exactly "false"
#   QUO_INBOUND_AUTOREPLY_ENABLED  does nothing unless it is exactly "true"

QUO_API_KEY=""
QUO_USER_ID=""
QUO_FROM_NUMBER=""
# Verifies inbound webhook calls from Quo.
QUO_WEBHOOK_SECRET=""
# Leave unset. Only "false" enables application-originated outbound SMS.
QUO_OUTBOUND_SMS_DISABLED=""
# "true" enables the inbound-triggered auto-reply. Nothing else.
QUO_INBOUND_AUTOREPLY_ENABLED=""


# =============================================================================
# META (lead ads, publishing, pixel)
# =============================================================================

# Lead-ad ingestion (/api/meta-leads, on a 5 minute cron).
# Comma-separated lead form IDs to pull.
META_LEAD_FORM_IDS=""
# Token Meta echoes back when verifying the webhook subscription.
META_VERIFY_TOKEN=""
# Verifies the signature on incoming Meta webhook payloads.
META_APP_SECRET=""

# Page publishing and OAuth.
META_APP_ID=""
META_PAGE_ID="887023637835514"
META_PAGE_ACCESS_TOKEN=""
META_OAUTH_REDIRECT_URI="https://www.theleadflowpro.com/api/admin/social/meta/callback"
META_GRAPH_VERSION="v26.0"
# Legacy alias. lib/social-server.ts falls back to it when META_APP_ID is unset.
FACEBOOK_APP_ID=""


# =============================================================================
# ANALYTICS
# =============================================================================

# --- Google Search Console (the /admin analytics dashboards) ---
# Create a Google Cloud service account, enable the Search Console API, then
# add the service account email as a user on the Search Console property.
GSC_CLIENT_EMAIL=""
# The private_key field out of the service-account JSON. \n-escaped is fine.
GSC_PRIVATE_KEY=""
# The property exactly as Search Console names it: "sc-domain:theleadflowpro.com"
# for a domain property, "https://www.theleadflowpro.com/" for a URL-prefix one.
GSC_SITE_URL=""

# --- PageSpeed (the website grader) ---
# Optional. Runs without a key at low volume; a key raises the quota.
GOOGLE_PAGESPEED_API_KEY=""


# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# --- HeyGen (the AI Video Studio in /admin/videos) ---
# Unset means the studio shows its setup notice instead of calling out.
HEYGEN_API_KEY=""


# =============================================================================
# LOCAL TOOLING. Not needed in Vercel.
# =============================================================================

# Where `npm run check:a11y` points. Defaults to http://localhost:3000.
BASE_URL=""
# Chromium binary for the a11y checker, when the bundled one is not usable.
CHROMIUM_PATH=""


# =============================================================================
# NOT USED. Do not add these back without a matching process.env read.
# =============================================================================
#
# Prisma was removed: there is no DATABASE_URL, no schema, and no migration
# step. `npm run build` and `npm run build:only` never touch the production
# database. Supabase is the only datastore and it is reached over its REST API.
#
# Also gone and previously documented here as if they were live:
#   DATABASE_URL, NEXTAUTH_URL, NEXTAUTH_SECRET  (Prisma / NextAuth)
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER  (Quo replaced it)
#   XAI_API_KEY, LEADREP_*, GROK_MAX_DAILY_COST_USD  (LeadRep orchestrator)
#   INSTAGRAM_*, TIKTOK_*, TWITTER_*, YOUTUBE_*  (never wired up)
#   ANTHROPIC_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   GOOGLE_PLACES_API_KEY, X_BEARER_TOKEN, FB_PAGE_ID, FB_PAGE_ACCESS_TOKEN
#   META_ACCESS_TOKEN, IG_ACCESS_TOKEN, LEADFLOW_INTEGRATION_SECRET_KEY
#   LEADFLOW_ADMIN_EMAILS, LEADFLOW_NOTIFY_EMAIL, RESEND_FROM_ADDRESS
#   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   NEXT_PUBLIC_META_PIXEL_ID  (the pixel ID is a row in `settings`, not env)
